{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "jsx": "react-native",
    "skipLibCheck": true,
    "paths": { "@/*": ["./*"] },
    "typeRoots": ["./node_modules/@types", "."]
  },
  "include": ["**/*.ts", "**/*.tsx", "react-native.d.ts"]
}
