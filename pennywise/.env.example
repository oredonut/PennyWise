# -----------------------------------------------------------------------------
# Supabase (Dashboard → Project Settings → API, or Connect dialog)
# Copy to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Project URL (same for client and server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Client-safe key for browser + Next.js middleware/server cookie sessions.
# Prefer the publishable key (API Keys tab). Legacy projects can use anon instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key — only needed if you are not using NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# The app falls back to this when publishable is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS; never expose to the client (no NEXT_PUBLIC_ prefix).
# Use in Route Handlers, server actions, or calling Edge Functions with elevated access.
SUPABASE_SERVICE_ROLE_KEY=
